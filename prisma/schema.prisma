generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JobApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  fullName             String
  email                String
  phone                String
  location             String
  linkedInUrl          String
  portfolioUrl         String?
  position             String
  roleSlug             String   @default("")
  yearsExperience      String
  experienceBand       String   @default("")
  currentCtc           String?
  expectedCtc          String?
  noticePeriod         String?
  startDate            String
  salaryExpectation    String
  legalAuthorization   String
  visaSponsorship      String

  resumePathname    String
  resumeFileName    String
  resumeContentType String
  resumeSizeBytes   Int
  otherDocumentPathname    String?
  otherDocumentFileName    String?
  otherDocumentContentType String?
  otherDocumentSizeBytes   Int?

  @@index([createdAt])
  @@index([email])
}
